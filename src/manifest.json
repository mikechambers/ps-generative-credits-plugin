{
  "id": "com.mikechambers.ps.credits",
  "name": "Generative Credits Costs",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "creditsPanel",
      "minimumSize": {
        "width": 300,
        "height": 400
      },
      "maximumSize": {
        "width": 800,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 350,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 700
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://helpx.adobe.com"
      ]
    }
  }
}